{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Agent(general-purpose)",
      "mcp__harness-vault-comum__create_note_tool",
      "mcp__harness-vault-comum__update_note_tool",
      "mcp__harness-vault-comum__delete_note_tool",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.production)"
    ]
  },
  "enabledPlugins": {
    "aia-harness@leandro-plugins-registry": false,
    "feature-dev@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "ui-theme-designer@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "gsap-skills@gsap-skills": false,
    "github@claude-plugins-official": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit|Bash|Agent|Task|mcp__obsidian__.*|mcp__harness-vault-.*|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/despachante.mjs\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/relato-guard.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/recibo-guard.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
